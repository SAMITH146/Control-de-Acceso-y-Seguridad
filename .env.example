# Puerto donde correrá el servidor Express
PORT=3000

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=sistema_escoltas
DB_PORT=3306

# Secret clave para firma de Tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_super_segura
JWT_EXPIRES_IN=12h
